# Explicit Testnet deployment configuration. Never put private keys or seed phrases here.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ESCROW_CONTRACT_ACCOUNT=escrow.example.testnet
NEAR_DEPLOYER_ACCOUNT_ID=escrow.example.testnet
NEAR_ADMINISTRATOR_ACCOUNT_ID=admin.example.testnet
NEAR_AUTHORIZED_VERIFIER_ACCOUNT_ID=verifier.example.testnet
NEAR_INITIALIZATION_DEPOSIT_NEAR=0.1
# Measure and approve these storage deposits for the deployed contract before a live lifecycle test.
# NEAR_PROJECT_STORAGE_DEPOSIT_YOCTO=
# NEAR_MILESTONE_STORAGE_DEPOSIT_YOCTO=
# NEAR_VERIFICATION_STORAGE_DEPOSIT_YOCTO=
# NEAR_APPROVAL_STORAGE_DEPOSIT_YOCTO=
# NEAR_SETTLEMENT_STORAGE_DEPOSIT_YOCTO=

# Required only for a deliberate future --execute invocation.
NEAR_CLI_MODE=classic
ATTESTRA_DEPLOY_AUTHORIZATION=I_UNDERSTAND_ATTESTRA_TESTNET_DEPLOYMENT

# Set after reviewing actual CLI transaction output; never invent values.
# NEAR_DEPLOYMENT_TRANSACTION_HASH=
# NEAR_INITIALIZATION_TRANSACTION_HASH=

# Optional report path.
# ATTESTRA_DEPLOYMENT_REPORT=.data/near-testnet-deployment-report.json

# AI provider (do not commit real credentials)
ATTESTRA_LLM_API_KEY=YOUR_GEMINI_API_KEY
ATTESTRA_LLM_MODEL=gemini-3.1-flash-lite
ATTESTRA_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ATTESTRA_LLM_TIMEOUT_MS=120000
ATTESTRA_LLM_MAX_RETRIES=1
ATTESTRA_DEMO_MODE=false

# NEAR Testnet
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_ESCROW_CONTRACT_ACCOUNT=
NEAR_DEPLOYER_ACCOUNT_ID=
NEAR_ADMINISTRATOR_ACCOUNT_ID=
NEAR_AUTHORIZED_VERIFIER_ACCOUNT_ID=
# Server-only restricted NEAR credential JSON (Render secret; never use NEXT_PUBLIC_).
ATTESTRA_NEAR_SIGNER_CREDENTIAL_JSON=
# Local alternative: protected mode-0600 near-api-js credential file.
ATTESTRA_NEAR_SIGNER_CREDENTIAL_FILE=
ATTESTRA_NEAR_SIGNER_SECRET_REF=
NEAR_VERIFICATION_STORAGE_DEPOSIT_YOCTO=
NEAR_APPROVAL_STORAGE_DEPOSIT_YOCTO=
NEAR_SETTLEMENT_STORAGE_DEPOSIT_YOCTO=
NEAR_INITIALIZATION_DEPOSIT_NEAR=
NEAR_AUTH_RECIPIENT=attestra.app
# Conservative storage deposits, measured/approved for the deployed contract.
NEAR_PROJECT_STORAGE_DEPOSIT_YOCTO=
NEAR_MILESTONE_STORAGE_DEPOSIT_YOCTO=

# Local application URLs
API_PORT=4000
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Leave DATABASE_URL empty for local JSON development. Production must use a
# postgresql:// or postgres:// Supabase connection string.
DATABASE_URL=
ATTESTRA_DATA_DIR=.data
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true

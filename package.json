{
  "name": "attestra",
  "version": "0.1.0",
  "private": true,
  "description": "ATTESTRA — autonomous multi-agent project execution with proof-gated payments on NEAR.",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "build": "pnpm -r build",
    "near:prepare": "node scripts/deploy-near-testnet.mjs --prepare",
    "dev": "pnpm --parallel --filter @attestra/api --filter @attestra/web dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
